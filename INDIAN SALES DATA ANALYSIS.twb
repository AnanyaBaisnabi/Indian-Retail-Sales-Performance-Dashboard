    <worksheet name='PROFIT BY CATEGORY'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#59a14f' fontname='Tableau Bold' fontsize='12'>PROFIT BY CATEGORY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='indian_store_sales_data' name='federated.0muur5d0kcckg71a2tnpc1ia7r6d' />
          </datasources>
          <datasource-dependencies datasource='federated.0muur5d0kcckg71a2tnpc1ia7r6d'>
            <column caption='PROFIT MARGIN' datatype='real' default-format='p0.00%' name='[Calculation_1337287643505909763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
            </column>
            <column datatype='string' name='[Category of Goods]' role='dimension' type='nominal' />
            <column datatype='real' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column datatype='real' default-format='n#,##0,,,.00B;-#,##0,,,.00B' name='[Sales]' role='measure' type='quantitative' />
