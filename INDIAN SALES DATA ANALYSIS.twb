              <zone fixed-size='398' forceUpdate='true' h='55014' id='36' is-fixed='true' type='text' w='11054' x='88360' y='24662'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#f1ce63' fontname='Tableau Bold' fontsize='11'>INSIGHTS</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#72b966' fontname='Tableau Bold'>Q3 shows marginally higher profit than other quarters.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#72b966' fontname='Tableau Bold'>Electric Appliances accounted for the largest sales share. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#72b966' fontname='Tableau Bold'>East region generated the highest revenue. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#72b966' fontname='Tableau Bold'>Fast Food delivered the strongest profitability. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#72b966' fontname='Tableau Bold'>Rajasthan recorded the highest profit. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#72b966' fontname='Tableau Bold'>Profit margins vary across state-category combinations.</run>
                </formatted-text>
                <zone-style>
