    <dashboard name='Story 1' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#72b966' fontsize='16'>BUSINESS PERFORMANCE OVERVIEW</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#000000' />
        </style-rule>
        <style-rule element='story-description'>
          <format attr='background-color' id='story-description_6' value='#000000d9' />
          <format attr='background-color' id='story-description_7' value='#000000d9' />
          <format attr='background-color' id='story-description_8' value='#000000d9' />
          <format attr='background-color' id='story-description_9' value='#000000d9' />
          <format attr='background-color' id='story-description_10' value='#000000d9' />
          <format attr='background-color' id='story-description_11' value='#000000d9' />
          <format attr='border-width' id='story-description_7' value='0' />
          <format attr='border-style' id='story-description_7' value='none' />
          <format attr='border-width' id='story-description_6' value='0' />
          <format attr='border-style' id='story-description_6' value='none' />
          <format attr='border-width' id='story-description_8' value='0' />
          <format attr='border-style' id='story-description_8' value='none' />
          <format attr='border-width' id='story-description_9' value='0' />
          <format attr='border-style' id='story-description_9' value='none' />
          <format attr='border-width' id='story-description_11' value='0' />
          <format attr='border-style' id='story-description_11' value='none' />
          <format attr='border-width' id='story-description_10' value='0' />
          <format attr='border-style' id='story-description_10' value='none' />
        </style-rule>
        <style-rule element='story-point-caption'>
          <format attr='width' value='322' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='97260' id='1' param='vert' removable='false' type='layout-flow' w='98614' x='693' y='1370'>
            <zone h='4966' id='3' type='title' w='98614' x='693' y='1370' />
            <zone h='17295' id='4' is-fixed='true' paired-zone-id='5' removable='false' type='flipboard-nav' w='98614' x='693' y='6336' />
            <zone h='74999' id='5' paired-zone-id='4' removable='false' type='flipboard' w='98614' x='693' y='23631'>
              <flipboard active-id='6' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='The business generated ₹2.51B in revenue and ₹375.53M in profit, achieving a healthy 14.97% profit margin. Strong profitability indicates effective revenue conversion and provides opportunities for targeted growth initiatives.' captured-sheet='INDIAN SALES PERFORMANCE DASHBOARD' id='1' />
                  <story-point caption='The East region generated the highest revenue (₹635.3M), while the West region recorded the lowest sales among the four regions.Regional sales are highly balanced, indicating that growth opportunities are likely to come from improving profitability rather than geographic expansion.' captured-sheet='SALES BY REGION' id='2' />
                  <story-point caption='Household Items and Fast Food emerged as the most profitable categories, contributing significantly to overall business profitability.These categories should remain priority areas for inventory and promotional investment.' captured-sheet='PROFIT BY CATEGORY' id='3' />
                  <story-point caption='Q3 delivered the highest profitability despite stable sales levels, suggesting favorable product mix, pricing, seasonal demand pattern or operational factors that merit further investigation.Replicating successful Q3 strategies may improve performance across other quarters.' captured-sheet='QUARTERLY SALES TREND' id='4' />
                  <story-point caption='The business achieved an overall profit margin of 14.97%, generating ₹375.53M profit from ₹2.51B in sales. Maintaining margins around 15% . This demonstrates strong operational performance, though further category-level optimization could improve overall profitability .' captured-sheet='PROFIT MARGIN BY STATE AND CATEGORY' id='5' />
                  <story-point caption='The dashboard reveals that revenue is driven primarily by the East region, profitability is concentrated in Household Items and Fast Food categories, and Q3 delivers the strongest margins, suggesting opportunities to scale successful products and replicate high-performing seasonal strategies' captured-sheet='' id='6' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='5137' hidden='true' id='6' story-point-id='2' type='text' w='27359' x='34719' y='23973'>
          <formatted-text>
            <run fontcolor='#59a14f' fontname='Tableau Bold' fontsize='12'>REGIONAL PERFORMANCE ANANLYSIS</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='5137' hidden='true' id='7' story-point-id='3' type='text' w='18182' x='63463' y='34418'>
          <formatted-text>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Bold' fontsize='12'>CATEGORY PROFITABILITY</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='5137' hidden='true' id='8' story-point-id='4' type='text' w='25541' x='29784' y='51199'>
          <formatted-text>
            <run fontcolor='#59a14f' fontname='Tableau Bold' fontsize='12'>QUARTERLY SALES &amp; PROFIT TREND</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='5137' hidden='true' id='9' story-point-id='5' type='text' w='31602' x='32035' y='20548'>
          <formatted-text>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Bold' fontsize='12'>PROFIT MARGIN BY STATE AND CATEGORY</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='5651' id='10' story-point-id='6' type='text' w='30043' x='34545' y='24315'>
          <formatted-text>
            <run fontcolor='#f9a655' fontname='Tableau Bold' fontsize='18'>KEY RECOMMENDATIONS </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='66952' id='11' story-point-id='6' type='text' w='91688' x='4589' y='30993'>
          <formatted-text>
            <run bold='true' fontcolor='#f1ce63' fontname='Tableau Medium' fontsize='11'>Recommendation 1:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Medium' fontsize='11'>Prioritize East Region Growth</run>
            <run lmargin='600' rmargin='600'>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Medium' fontsize='11' lmargin='600' rmargin='600'>The East region contributes the highest revenue and offers the strongest foundation for future expansion.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#f1ce63' fontname='Tableau Medium' fontsize='11'>Recommendation 2:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Medium' fontsize='11'>Scale High-Profit Categories</run>
            <run lmargin='600' rmargin='600'>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Medium' fontsize='11' lmargin='600' rmargin='600'>Increase focus on Household Items and Fast Food categories to maximize profitability and return on investment.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#f1ce63' fontname='Tableau Medium' fontsize='11'>Recommendation 3:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Medium' fontsize='11'>Replicate Q3 Success Factors</run>
            <run lmargin='600' rmargin='600'>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Medium' fontsize='11' lmargin='600' rmargin='600'>Investigate pricing, promotions, and operational strategies used in Q3 and apply successful practices year-round.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#f1ce63' fontname='Tableau Medium' fontsize='11'>Recommendation 4:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Medium' fontsize='11'>Improve Low-Performing States</run>
            <run lmargin='600' rmargin='600'>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Medium' fontsize='11' lmargin='600' rmargin='600'>Target states with lower profit margins through localized marketing, pricing optimization, and inventory adjustments.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#f1ce63' fontname='Tableau Medium' fontsize='11'>Recommendation 5:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Medium' fontsize='11'>Optimize Product Mix</run>
            <run lmargin='600' rmargin='600'>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Medium' fontsize='11' lmargin='600' rmargin='600'>Allocate resources toward high-margin products while reducing dependence on lower-performing categories.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#f1ce63' fontname='Tableau Medium' fontsize='11'>Recommendation 6:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Medium' fontsize='11'>Monitor Margin Sustainability</run>
            <run lmargin='600' rmargin='600'>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Medium' fontsize='11' lmargin='600' rmargin='600'>Focus on balancing revenue growth with profitability to maintain margins above 15%.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{73BBC905-DFCA-4398-8797-6E78E5A70DB4}' />
